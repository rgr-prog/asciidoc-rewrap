{
  "name": "asciidoc-rewrap",
  "displayName": "AsciiDoc Rewrap",
  "description": "Hard-wrap AsciiDoc prose while preserving its block syntax.",
  "keywords": [
    "asciidoc",
    "asciidoctor",
    "adoc",
    "word wrap",
    "hard wrap"
  ],
  "version": "0.1.1",
  "publisher": "RogerioCunha",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=12.x",
    "vscode": "^1.63.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Formatters"
  ],
  "markdown": "standard",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:asciidoc",
    "onCommand:asciidocRewrap.rewrap",
    "onCommand:asciidocRewrap.rewrapAt",
    "onCommand:asciidocRewrap.toggleAutoWrap"
  ],
  "main": "./dist/Extension.node.js",
  "browser": "./dist/Extension.browser.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "asciidocRewrap.rewrap",
        "title": "AsciiDoc Rewrap: Wrap Text"
      },
      {
        "command": "asciidocRewrap.rewrapAt",
        "title": "AsciiDoc Rewrap: Wrap / Unwrap at Column..."
      },
      {
        "command": "asciidocRewrap.toggleAutoWrap",
        "title": "AsciiDoc Rewrap: Toggle Auto-Wrap"
      }
    ],
    "configuration": {
      "title": "AsciiDoc Rewrap",
      "properties": {
        "asciidocRewrap.wrappingColumn": {
          "scope": "language-overridable",
          "type": "number",
          "default": 0,
          "description": "Controls after how many characters text is wrapped."
        },
        "asciidocRewrap.doubleSentenceSpacing": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "When wrapping lines that end in a period, adds two spaces after that sentence in the wrapped text."
        },
        "asciidocRewrap.wholeComment": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": true,
          "description": "With the cursor inside a comment block, wrap the whole comment block instead of just a single paragraph."
        },
        "asciidocRewrap.reformat": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "(EXPERIMENTAL) When wrapping lines, reformat paragraph indents."
        },
        "asciidocRewrap.onSave": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Do a rewrap on the whole document when saving."
        },
        "asciidocRewrap.autoWrap.enabled": {
          "scope": "language-overridable",
          "type": "boolean",
          "default": false,
          "description": "Wraps automatically when the cursor is past the wrapping column."
        },
        "asciidocRewrap.autoWrap.notification": {
          "scope": "language-overridable",
          "type": "string",
          "description": "Notification type for when auto-wrap is on/off for the current document.",
          "enum": [
            "icon",
            "text"
          ],
          "enumDescriptions": [
            "Shows permanently when auto-wrap is on in the current document; hidden when it is off",
            "Shows briefly the auto-wrap state for the current document, only when it is toggled on/off manually via the command"
          ],
          "default": "icon"
        }
      }
    },
    "keybindings": [
      {
        "command": "asciidocRewrap.rewrap",
        "key": "alt+q",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "asciidoc",
        "aliases": [
          "AsciiDoc",
          "asciidoc"
        ],
        "extensions": [
          ".adoc"
        ]
      }
    ]
  },
  "devDependencies": {
    "fast-diff": "^1.3.0",
    "json5": "^2.2.3"
  },
  "source": "src/Extension.ts",
  "targets": {
    "main": {
      "source": "src/Extension.node.ts",
      "context": "node",
      "optimize": true,
      "includeNodeModules": {
        "vscode": false
      }
    },
    "browser": {
      "source": "src/Extension.browser.ts",
      "context": "browser",
      "optimize": true,
      "includeNodeModules": {
        "vscode": false
      }
    }
  },
  "author": "Rogério Ferreira da Cunha",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgr-prog/asciidoc-rewrap.git"
  },
  "bugs": {
    "url": "https://github.com/rgr-prog/asciidoc-rewrap/issues"
  },
  "homepage": "https://github.com/rgr-prog/asciidoc-rewrap#readme"
}
